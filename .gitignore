# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------------------------------------------------------
# Large data artifacts (raw + intermediate tensors)
# ---------------------------------------------------------------------------
# Pseudobulk h5ad collections (multi-GB)
data/Tahoe100M_Pseudobulk_processed/

# Tensor artifact directories (any Tahoe100M tensor bundle, L1000 / plate / etc.)
data/Tahoe100M_tensor_artifacts*/

# Misc large/reference data files
data/Morganfingerprints.csv
data/geneinfo_beta.txt
data/landmark_genes.csv

# Catch-all for common large binary formats anywhere in the repo
*.h5ad
*.h5
*.hdf5
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.pt
*.pth
*.safetensors

# ---------------------------------------------------------------------------
# Model training artifacts / checkpoints
# ---------------------------------------------------------------------------
# Everything under artifacts/ (Lightning logs, checkpoints, sklearn joblibs, etc.)
artifacts/

# Safety net for model files outside artifacts/
*.ckpt
*.joblib
*.pkl
*.pickle

# Lightning / TensorBoard run directories
lightning_logs/
tb_logs/
wandb/
mlruns/

# ---------------------------------------------------------------------------
# Hydra / run outputs
# ---------------------------------------------------------------------------
outputs/*/
!outputs/*.txt
!outputs/*.jsonl
multirun/

# ---------------------------------------------------------------------------
# Keep tracked exceptions
# ---------------------------------------------------------------------------
# The two small pseudobulk samples that are already tracked stay tracked via
# git's existing index; if you want to re-add them after the *.h5ad rule,
# use `git add -f <path>`.
